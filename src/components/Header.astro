---
import LanguageSelector from './LanguageSelector.astro';

const navigation = [
  { label: 'Inicio', key: 'nav.home', href: '#inicio' }, { label: 'Fiestas', key: 'nav.fiestas', href: '#programa' }, { label: 'Eventos', key: 'nav.events', href: '#eventos' }, { label: 'Mapa', key: 'nav.map', href: '#mapa' }, { label: 'Participa', key: 'nav.participate', href: '#participa' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="#inicio" aria-label="Ir al inicio">
      <span class="brand-mark" aria-hidden="true">FEP</span>
      <span class="brand-name"><span data-i18n="brand.district">Distrito</span><br /><strong>Fuencarral–El Pardo</strong></span>
    </a>

    <nav class="desktop-nav" aria-label="Navegación principal">
      {navigation.map((item) => <a href={item.href} data-i18n={item.key}>{item.label}</a>)}
    </nav>

    <LanguageSelector />

    <a class="download-link" href="/programme/programa-fiestas-el-pardo-2026.pdf" target="_blank" rel="noreferrer">
      <span aria-hidden="true">↓</span><span data-i18n="nav.program">Programa</span>
    </a>

    <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu">
      <span class="sr-only">Abrir menú</span>
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-menu" aria-label="Navegación móvil" hidden>
    <div class="container">
      {navigation.map((item) => <a href={item.href} data-i18n={item.key}>{item.label}</a>)}
    </div>
  </nav>
</header>

<style>
  .site-header { position: absolute; z-index: 20; top: 0; width: 100%; color: white; }
  .header-inner { display: flex; align-items: center; min-height: 5.6rem; gap: 1rem; }
  .brand { display: inline-flex; align-items: center; gap: .7rem; color: white; text-decoration: none; }
  .brand-mark { display: grid; width: 2.85rem; height: 2.85rem; place-items: center; border: 2px solid currentColor; border-radius: .65rem; font-size: .7rem; font-weight: 900; letter-spacing: -.04em; }
  .brand-name { font-size: .72rem; line-height: 1.07; }
  .brand-name strong { font-size: .96rem; }
  .desktop-nav { display: none; margin-left: auto; gap: 1.15rem; font-size: .86rem; font-weight: 700; }
  .desktop-nav a { color: white; text-decoration: none; opacity: .88; }
  .desktop-nav a:hover { opacity: 1; text-decoration: underline; text-underline-offset: .35rem; }
  :global(.language-selector) { margin-left: auto; }.download-link { display: inline-flex; align-items: center; gap: .35rem; margin-left: 0; border: 1px solid rgba(255,255,255,.72); border-radius: 999px; padding: .56rem .8rem; color: white; font-size: .78rem; font-weight: 800; text-decoration: none; }
  .download-link span { font-size: 1.15rem; line-height: .6; }
  .menu-button { display: grid; width: 2.7rem; height: 2.7rem; place-content: center; gap: .27rem; border: 0; background: transparent; color: white; cursor: pointer; }
  .menu-button span:not(.sr-only) { display: block; width: 1.55rem; height: .16rem; border-radius: 10px; background: currentColor; }
  .mobile-nav { position: absolute; top: 100%; width: 100%; padding: .5rem 0 1rem; background: var(--blue-dark); box-shadow: 0 14px 20px rgba(0,0,0,.2); }
  .mobile-nav .container { display: grid; }
  .mobile-nav a { border-bottom: 1px solid rgba(255,255,255,.2); padding: .85rem .2rem; color: white; font-weight: 700; text-decoration: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  @media (max-width: 530px) { .download-link { display: none; } }
  @media (min-width: 880px) {
    .brand-mark { width: 3.1rem; height: 3.1rem; }
    .brand-name { font-size: .78rem; }
    .brand-name strong { font-size: 1.07rem; }
    .desktop-nav { display: flex; }.language-selector { margin-left: 1rem; }
    .download-link { margin-left: 0; }
    .menu-button, .mobile-nav { display: none !important; }
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');

  button?.addEventListener('click', () => {
    const isOpen = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!isOpen));
    if (menu) menu.hidden = isOpen;
  });

  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
    button?.setAttribute('aria-expanded', 'false');
    menu.hidden = true;
  }));
</script>
