---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<BaseLayout title={`${title} | Fiestas del Real Sitio de El Pardo`} description={description}>
  <header class="subpage-header">
    <div class="container subpage-header__inner">
      <a href="/" class="subpage-brand" aria-label="Volver al inicio de las fiestas">
        <span>FEP</span>
        <strong>Fuencarral–El Pardo</strong>
      </a>
      <a class="back-link" href="/#participa">← Volver a Participa</a>
    </div>
  </header>
  <main>
    <section class="subpage-hero">
      <div class="container">
        <p>{eyebrow}</p>
        <h1 class="display-font">{title}</h1>
        <span>{description}</span>
      </div>
    </section>
    <section class="subpage-content container">
      <slot />
    </section>
  </main>
</BaseLayout>

<style>
  .subpage-header { background: var(--blue); color: white; }
  .subpage-header__inner { display: flex; min-height: 5rem; align-items: center; justify-content: space-between; gap: 1rem; }
  .subpage-brand { display: inline-flex; align-items: center; gap: .65rem; color: white; font-size: .95rem; text-decoration: none; }
  .subpage-brand span { display: grid; width: 2.55rem; height: 2.55rem; place-content: center; border: 2px solid currentColor; border-radius: .6rem; font-size: .63rem; font-weight: 900; }
  .back-link { color: white; font-size: .82rem; font-weight: 800; text-decoration: none; }
  .back-link:hover { text-decoration: underline; text-underline-offset: .3rem; }
  .subpage-hero { padding: clamp(3rem, 7vw, 5rem) 0; background: #f7f2e7; }
  .subpage-hero p { margin: 0 0 .65rem; color: var(--blue); font-size: .75rem; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
  .subpage-hero h1 { margin: 0; color: #111; font-size: clamp(3rem, 7vw, 5.8rem); line-height: .9; }
  .subpage-hero span { display: block; max-width: 58ch; margin-top: 1.25rem; color: #485761; font-size: 1.05rem; font-weight: 600; line-height: 1.55; }
  .subpage-content { padding-block: clamp(3rem, 5vw, 4.5rem); }
</style>
