---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import GoogleFormQr from '../components/GoogleFormQr.astro';
import { events, featuredEvents } from '../data/events';
import { googleSurveyUrl } from '../data/participation';

const dates = ['29', '30', '31', '1', '2', '3', '4', '5', '6'];
const categories = ['Todos', 'Música', 'Infantil', 'Deportes', 'Tradición', 'Cultura', 'Gastronomía'];
---

<BaseLayout>
  <Header />
  <main>
    <section class="hero" id="inicio" aria-labelledby="hero-title">
      <img class="hero-image" src="/images/Portada1.jpeg" alt="Ilustración de las Fiestas del Real Sitio de El Pardo" />
      <div class="hero-overlay"></div>
      <div class="container hero-content">
        <p class="hero-kicker" data-i18n="hero.dates">29 agosto — 6 septiembre 2026</p>
        <h1 id="hero-title" class="display-font" data-i18n="hero.title">Nueve días de tradición, música y alegría</h1>
        <p class="hero-copy" data-i18n="hero.copy">Vuelve a encontrarte con El Pardo: actividades para disfrutar en familia, con amistades y con todo el barrio.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#eventos"><span data-i18n="hero.events">Ver eventos</span> <span aria-hidden="true">→</span></a>
          <a class="button button-ghost" href="#mapa"><span data-i18n="hero.map">Cómo llegar</span> <span aria-hidden="true">⌖</span></a>
        </div>
      </div>
      <div class="countdown-wrap container">
        <div class="countdown" data-countdown data-date="2026-08-29T00:00:00+02:00" aria-live="polite">
          <span class="countdown-icon" aria-hidden="true">✦</span>
          <p><strong data-i18n="countdown.copy">Faltan para el inicio de las fiestas</strong></p>
          <div><strong data-countdown-value>—</strong><span data-countdown-label data-i18n="countdown.days">días</span></div>
        </div>
      </div>
    </section>

    <section class="section programme" id="programa" aria-labelledby="programme-heading">
      <div class="container">
        <div class="section-topline">
          <div>
            <p class="eyebrow" data-i18n="programme.label">Agenda principal</p>
            <h2 id="programme-heading" class="display-font section-heading" data-i18n="programme.title">Programa por días</h2>
          </div>
          <a class="text-link" href="/programme/programa-fiestas-el-pardo-2026.pdf" target="_blank" rel="noreferrer"><span data-i18n="programme.download">Descargar programa</span> <span aria-hidden="true">↗</span></a>
        </div>

        <div class="programme-carousel" aria-label="Programa por días">
          <button class="carousel-button carousel-button--previous" type="button" aria-label="Ver días anteriores" data-programme-previous>←</button>
          <div class="day-grid" data-programme-track tabindex="0">
            {dates.map((date) => {
              const dayEvents = events.filter((event) => event.day === date);
              const first = dayEvents[0];
              return (
                <article class="day-card">
                  <p class="day-name display-font" data-i18n={`weekday.${first.weekday}`}>{first.weekday}</p>
                  <p class="day-date"><strong>{date}</strong> <span data-i18n={`month.${first.date}`}>{first.date}</span></p>
                  <ul>
                    {dayEvents.map((event) => <li><time>{event.time}</time><span data-i18n={`event.${event.id}.title`}>{event.title}</span></li>)}
                  </ul>
                  <a href="#eventos"><span data-i18n="programme.more">Más información</span> <span aria-hidden="true">→</span></a>
                </article>
              );
            })}
          </div>
          <button class="carousel-button carousel-button--next" type="button" aria-label="Ver días siguientes" data-programme-next>→</button>
        </div>
      </div>
    </section>

    <section class="section featured" aria-labelledby="featured-heading">
      <div class="container">
        <p class="eyebrow" data-i18n="featured.label">Una cita para cada plan</p>
        <h2 id="featured-heading" class="display-font section-heading" data-i18n="featured.title">No te pierdas…</h2>
        <div class="featured-grid">
          {featuredEvents.map((event) => (
            <article class="featured-card">
              <img src={event.image} alt="" loading="lazy" />
              <div>
                <p data-i18n={`category.${event.category}`}>{event.category}</p>
                <h3 class="display-font" data-i18n={`featured.${event.id}.title`}>{event.title}</h3>
                <span data-i18n={`featured.${event.id}.date`}>{event.date}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section events-section" id="eventos" aria-labelledby="events-heading">
      <div class="container">
        <div class="section-topline">
          <div>
            <p class="eyebrow" data-i18n="events.label">Consulta el programa</p>
            <h2 id="events-heading" class="display-font section-heading" data-i18n="events.title">Todos los eventos</h2>
          </div>
          <p class="event-count" data-event-count data-i18n="events.count">{events.length} actividades</p>
        </div>

        <div class="event-controls" aria-label="Filtros del programa" data-i18n-aria-label="events.filters">
          <label class="search-box">
            <span class="sr-only" data-i18n="events.searchLabel">Buscar eventos</span>
            <input type="search" placeholder="Buscar eventos…" data-search-events data-i18n-placeholder="events.searchPlaceholder" />
            <span aria-hidden="true">⌕</span>
          </label>
          <div class="filter-list" role="group" aria-label="Filtrar por categoría" data-i18n-aria-label="events.filterByCategory">
            {categories.map((category, index) => <button class:list={['filter-button', { active: index === 0 }]} type="button" data-filter={category} data-i18n={`category.${category}`}>{category}</button>)}
          </div>
        </div>

        <div class="events-grid" data-events-list>
          {events.map((event) => (
            <article class="event-card" data-event data-category={event.category} data-search={`${event.title} ${event.category} ${event.place}`.toLowerCase()}>
              <div class="event-card-date"><span data-i18n={`weekday.${event.weekday}`}>{event.weekday}</span><strong>{event.day}</strong><small data-i18n={`month.${event.date}`}>{event.date}</small></div>
              <div>
                <p class="event-meta"><time>{event.time} h</time><span data-i18n={`category.${event.category}`}>{event.category}</span></p>
                <h3 data-i18n={`event.${event.id}.title`}>{event.title}</h3>
                <p class="event-place">⌖ <span data-i18n={`event.${event.id}.place`}>{event.place}</span></p>
              </div>
            </article>
          ))}
        </div>
        <p class="no-events" data-no-events data-i18n="events.empty" hidden>No hay actividades que coincidan con la búsqueda.</p>
      </div>
    </section>

    <section class="section map-section" id="mapa" aria-labelledby="map-heading">
      <div class="container map-layout">
        <div class="map-copy">
          <p class="eyebrow" data-i18n="map.label">Encuentra cada actividad</p>
          <h2 id="map-heading" class="display-font section-heading" data-i18n="map.title">¿Dónde serán las actividades?</h2>
          <p data-i18n="map.copy">Consulta en el mapa todos los espacios donde se celebrarán las fiestas, desde los jardines hasta las plazas y carpas del Real Sitio.</p>
          <a class="button button-primary" href="https://www.openstreetmap.org/#map=15/40.516/-3.775" target="_blank" rel="noreferrer"><span data-i18n="map.open">Abrir el mapa</span> <span aria-hidden="true">↗</span></a>
        </div>
        <a class="map-image" href="https://www.openstreetmap.org/#map=15/40.516/-3.775" target="_blank" rel="noreferrer" aria-label="Abrir mapa de El Pardo">
          <img src="/images/ElPardo.png" alt="Mapa aéreo de El Pardo" loading="lazy" />
          <span class="map-pin pin-one">●</span><span class="map-pin pin-two">●</span><span class="map-pin pin-three">●</span>
        </a>
      </div>
    </section>

    <section class="section about-section" id="quienes-somos" aria-labelledby="about-heading">
      <div class="container about-layout">
        <div class="about-image"><img src="/images/Portada.jpeg" alt="Ilustración de una tarde de fiesta en El Pardo" loading="eager" /></div>
        <div>
          <p class="eyebrow" data-i18n="about.label">El Pardo es comunidad</p>
          <h2 id="about-heading" class="display-font section-heading" data-i18n="about.title">Queridos pardeños</h2>
          <p data-i18n="about.copyOne">Las Fiestas del Real Sitio nos reúnen para disfrutar de la música, la cultura, el deporte y las tradiciones que dan vida a nuestro distrito.</p>
          <p data-i18n="about.copyTwo">Gracias a la colaboración de asociaciones, entidades y vecindario, celebramos un programa pensado para todas las edades.</p>
        </div>
      </div>
    </section>

    <section class="section participate" id="participa" aria-labelledby="participate-heading">
      <div class="container">
        <p class="eyebrow" data-i18n="participate.label">Tu opinión cuenta</p>
        <h2 id="participate-heading" class="display-font section-heading" data-i18n="participate.title">Participa</h2>
        <p class="participate-intro" data-i18n="participate.copy">Ayúdanos a seguir mejorando el distrito.</p>
        <div class="participation-grid">
          <a href={googleSurveyUrl} class="participation-card" target="_blank" rel="noopener noreferrer"><span aria-hidden="true">☷</span><div><h3 data-i18n="card.survey">Encuesta oficial</h3><p data-i18n="card.surveyCopy">Comparte tu opinión sobre las fiestas.</p></div><b aria-hidden="true">↗</b></a>
          <a href="/participa/proponer-idea" class="participation-card"><span aria-hidden="true">✦</span><div><h3 data-i18n="card.idea">Propón tu idea</h3><p data-i18n="card.ideaCopy">Comparte propuestas para mejorar el distrito.</p></div><b aria-hidden="true">→</b></a>
          <a href="/participa/incidencias" class="participation-card"><span aria-hidden="true">⌁</span><div><h3 data-i18n="card.incident">Incidencias</h3><p data-i18n="card.incidentCopy">Comunica incidencias en tu barrio fácilmente.</p></div><b aria-hidden="true">→</b></a>
        </div>
        <GoogleFormQr />
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-main">
      <div>
        <a class="footer-brand" href="#inicio"><span>FEP</span> Fuencarral–El Pardo</a>
        <p data-i18n="footer.tagline">Tu distrito, tu comunidad.</p>
      </div>
      <div class="social-links" aria-label="Redes sociales">
        <a href="https://www.instagram.com/madrid" target="_blank" rel="noopener noreferrer" aria-label="Instagram del Ayuntamiento de Madrid">ig</a><a href="https://www.facebook.com/ayuntamientodemadrid/" target="_blank" rel="noopener noreferrer" aria-label="Facebook del Ayuntamiento de Madrid">f</a><a href="https://x.com/MADRID" target="_blank" rel="noopener noreferrer" aria-label="X del Ayuntamiento de Madrid">𝕏</a>
      </div>
      <nav aria-label="Enlaces legales" data-i18n-aria-label="footer.legalLinks"><a href="/contacto" data-i18n="footer.contact">Contacto</a><a href="/aviso-legal" data-i18n="footer.legal">Avisos legales</a><a href="/privacidad" data-i18n="footer.privacy">Privacidad</a><a href="/accesibilidad" data-i18n="footer.accessibility">Accesibilidad</a></nav>
    </div>
  </footer>

  <style>
    .hero { position: relative; isolation: isolate; display: grid; min-height: 790px; overflow: clip; background: #123f46; color: white; }
    .hero-image, .hero-overlay { position: absolute; z-index: -1; inset: 0; width: 100%; height: 100%; }
    .hero-image { object-fit: cover; object-position: 30% 78%; }
    @media (max-width: 640px) { .hero-image { object-position: 50% 78%; } }
    .hero-overlay { background: linear-gradient(90deg, rgba(3,34,49,.9) 0%, rgba(3,34,49,.8) 42%, rgba(3,34,49,.38) 62%, rgba(3,34,49,.06) 100%), linear-gradient(0deg, rgba(4,22,31,.58), transparent 54%); }
    .hero-content { align-self: center; padding-top: 6.5rem; padding-bottom: 10.5rem; }
    .hero-kicker { width: max-content; max-width: 100%; margin: 0 0 1.1rem; border-radius: 999px; padding: .48rem .78rem; background: rgba(255,255,255,.17); backdrop-filter: blur(6px); font-size: .75rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }
    .hero h1 { max-width: 12ch; margin: 0; font-size: clamp(3.25rem, 8vw, 6.7rem); line-height: .88; text-shadow: 0 3px 18px rgba(0,0,0,.28); }
    .hero-copy { max-width: 45ch; margin: 1.35rem 0 2rem; font-size: clamp(1rem, 2vw, 1.2rem); font-weight: 600; line-height: 1.5; }
    .hero-actions { display: flex; flex-wrap: wrap; gap: .7rem; }
    .button { display: inline-flex; align-items: center; justify-content: center; gap: .6rem; min-height: 3.2rem; border-radius: .8rem; padding: .7rem 1.05rem; font-weight: 850; text-decoration: none; transition: transform .18s ease, background .18s ease; }
    .button:hover { transform: translateY(-2px); }
    .button-primary { background: var(--blue); color: white; box-shadow: 0 10px 20px rgba(1,59,122,.24); }
    .button-primary:hover { background: var(--blue-dark); }
    .button-ghost { border: 1.5px solid rgba(255,255,255,.9); color: white; background: rgba(0,0,0,.12); }
    .countdown-wrap { align-self: end; margin-bottom: clamp(1.2rem, 3vw, 2.5rem); }
    .countdown { display: flex; align-items: center; gap: .7rem; width: min(100%, 440px); margin-left: auto; border-radius: 1rem; padding: .9rem 1rem; background: var(--blue); box-shadow: 0 14px 30px rgba(0,36,77,.28); }
    .countdown-icon { display: grid; width: 2.6rem; height: 2.6rem; flex: 0 0 auto; place-content: center; border: 2px solid white; border-radius: .7rem; font-size: 1.3rem; }
    .countdown p { flex: 1; margin: 0; font-size: .83rem; line-height: 1.1; }
    .countdown div { display: grid; text-align: center; line-height: 1; }
    .countdown div strong { font-size: 2.5rem; }
    .countdown div span { margin-top: .15rem; font-size: .75rem; font-weight: 800; text-transform: uppercase; }
    .section-topline { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: clamp(1.5rem, 3vw, 2.25rem); }
    .text-link { color: var(--blue); font-size: .92rem; font-weight: 850; text-decoration: none; white-space: nowrap; }
    .text-link:hover { text-decoration: underline; text-underline-offset: .3rem; }
    .programme-carousel { position: relative; }
    .day-grid { display: grid; grid-auto-columns: minmax(285px, 1fr); grid-auto-flow: column; gap: 1rem; overflow-x: auto; scroll-behavior: smooth; scroll-snap-type: x mandatory; padding: .3rem .1rem 1rem; scrollbar-width: none; }
    .day-grid::-webkit-scrollbar { display: none; }
    .day-card { display: flex; min-height: 290px; flex-direction: column; scroll-snap-align: start; border-radius: 1.15rem; padding: 1.35rem; background: var(--soft); }
    .day-name { margin: 0; color: var(--blue); font-size: 1.7rem; line-height: 1; }
    .day-date { margin: 0 0 1rem; color: #101820; font-size: .8rem; font-weight: 800; text-transform: uppercase; }
    .day-date strong { color: var(--blue); font-size: 2.8rem; line-height: .8; vertical-align: middle; }
    .day-card ul { display: grid; gap: .47rem; margin: 0; padding: 0; list-style: none; font-size: .82rem; }
    .day-card li { display: grid; grid-template-columns: 3.3rem 1fr; gap: .4rem; line-height: 1.2; }
    .day-card time { color: var(--blue); font-weight: 850; }
    .day-card a { margin-top: auto; padding-top: 1.2rem; color: var(--blue); font-size: .83rem; font-weight: 850; text-decoration: none; }
    .carousel-button { position: absolute; z-index: 1; top: 50%; display: grid; width: 2.7rem; height: 2.7rem; place-content: center; border: 0; border-radius: 50%; background: var(--blue); color: white; box-shadow: 0 6px 18px rgba(4,49,101,.26); font-size: 1.25rem; font-weight: 900; cursor: pointer; transform: translateY(-50%); transition: background .2s ease, transform .2s ease; }
    .carousel-button:hover { background: var(--blue-dark); transform: translateY(-50%) scale(1.06); }.carousel-button--previous { left: -1.35rem; }.carousel-button--next { right: -1.35rem; }
    .featured { background: #f7f2e7; }
    .featured .section-heading { margin-bottom: clamp(1rem, 1.8vw, 1.4rem); }
    .featured-grid { display: grid; grid-auto-columns: minmax(210px, 1fr); grid-auto-flow: column; gap: 1rem; overflow-x: auto; padding: .45rem .05rem 1rem; scrollbar-color: var(--blue) transparent; }
    .featured-card { overflow: hidden; border-radius: 1rem; background: white; box-shadow: 0 8px 20px rgba(25,39,45,.08); }
    .featured-card img { width: 100%; height: 150px; object-fit: cover; }
    .featured-card div { padding: .85rem .9rem 1rem; }
    .featured-card p { margin: 0 0 .35rem; color: var(--blue); font-size: .7rem; font-weight: 850; text-transform: uppercase; }
    .featured-card h3 { min-height: 2em; margin: 0; font-size: 1.45rem; line-height: .9; }
    .featured-card span { display: block; margin-top: .8rem; color: #53606a; font-size: .75rem; font-weight: 750; }
    .events-section { background: #f6f7f7; }
    .event-count { margin: 0; color: #53606a; font-size: .85rem; font-weight: 800; }
    .event-controls { display: grid; gap: 1rem; margin-bottom: 1.5rem; }
    .search-box { display: flex; align-items: center; max-width: 520px; border: 2px solid #1e2730; border-radius: .85rem; background: white; padding: .08rem .75rem; }
    .search-box input { width: 100%; border: 0; outline: none; padding: .8rem .2rem; background: transparent; color: var(--ink); font-weight: 650; }
    .search-box span { color: var(--blue); font-size: 1.55rem; }
    .filter-list { display: flex; gap: .5rem; overflow-x: auto; padding-bottom: .3rem; }
    .filter-button { flex: 0 0 auto; border: 0; border-radius: 999px; padding: .5rem .8rem; background: #e3e5e7; color: #1e2730; font-size: .8rem; font-weight: 800; cursor: pointer; }
    .filter-button.active, .filter-button:hover { background: var(--blue); color: white; }
    .events-grid { display: grid; gap: .9rem; }
    .event-card { display: grid; grid-template-columns: 72px 1fr; gap: 1rem; min-height: 145px; border-radius: 1rem; padding: 1rem; background: white; box-shadow: 0 5px 14px rgba(35,45,49,.07); }
    .event-card[hidden] { display: none; }
    .event-card-date { display: grid; align-content: start; justify-items: center; border-right: 1px solid #d8dee1; color: var(--blue); line-height: 1; }
    .event-card-date span { font-size: .7rem; font-weight: 850; text-transform: uppercase; }
    .event-card-date strong { margin: .25rem 0; font-size: 2.8rem; }
    .event-card-date small { color: #23313e; font-size: .65rem; font-weight: 800; text-transform: uppercase; }
    .event-meta { display: flex; gap: .55rem; margin: 0 0 .35rem; font-size: .72rem; font-weight: 850; }
    .event-meta time { color: var(--blue); }
    .event-meta span { color: #61717c; }
    .event-card h3 { margin: 0; font-size: 1rem; line-height: 1.15; }
    .event-place { margin: .65rem 0 0; color: #5c6972; font-size: .78rem; line-height: 1.25; }
    .no-events { padding: 1rem 0; color: #53606a; font-weight: 700; }
    .map-section { background: white; }
    .map-layout { display: grid; align-items: center; gap: clamp(1.5rem, 3vw, 2.75rem); }
    .map-copy > p:not(.eyebrow) { max-width: 38ch; margin: 1rem 0 1.5rem; line-height: 1.55; }
    .map-image { position: relative; display: block; min-height: clamp(280px, 32vw, 470px); aspect-ratio: 4 / 3; overflow: hidden; border-radius: 1.4rem; background: #d2dfd2; box-shadow: 0 13px 28px rgba(8,39,50,.16); }
    .map-image::after { position: absolute; inset: 0; content: ''; background: linear-gradient(120deg, rgba(4,56,100,.18), transparent 55%); }
    .map-image img { display: block; width: 100%; height: 100%; min-height: 0; object-fit: cover; object-position: center 40%; }
    .map-pin { position: absolute; z-index: 1; display: grid; width: 2.2rem; height: 2.2rem; place-content: center; border: 3px solid white; border-radius: 50% 50% 50% 0; background: var(--accent); color: white; box-shadow: 0 4px 8px rgba(0,0,0,.25); transform: rotate(-45deg); }
    .map-pin::first-letter { transform: rotate(45deg); }
    .pin-one { top: 41%; left: 46%; }.pin-two { top: 51%; left: 59%; background: var(--blue); }.pin-three { top: 60%; left: 38%; background: #8754b5; }
    .about-section { padding-block: clamp(2.5rem, 3.5vw, 3.5rem); background: #f7f2e7; }
    .about-layout { display: grid; align-items: center; gap: clamp(1.5rem, 3vw, 2.75rem); }
    .about-image { min-height: 300px; overflow: hidden; border-radius: 1.3rem; background: #e7ece7; }
    .about-image img { display: block; width: 100%; height: 100%; min-height: 300px; object-fit: cover; object-position: center; }
    .about-layout > div:last-child > .section-heading { margin-bottom: clamp(1rem, 1.8vw, 1.4rem); }
    .about-layout > div:last-child > p:not(.eyebrow) { max-width: 48ch; margin: 0; line-height: 1.6; }
    .participate { background: white; }
    .participate-intro { margin: 1rem 0 2rem; color: #59656e; font-size: 1.05rem; font-weight: 650; }
    .participation-grid { display: grid; gap: 1rem; }
    .participation-card { display: grid; grid-template-columns: 3.6rem 1fr auto; align-items: center; gap: 1rem; border: 2px solid var(--blue); border-radius: 1rem; padding: 1rem; color: var(--ink); text-decoration: none; transition: transform .18s ease, box-shadow .18s ease; }
    .participation-card:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(7,93,188,.13); }
    .participation-card > span { display: grid; width: 3.6rem; height: 3.6rem; place-content: center; border-radius: .85rem; background: var(--blue); color: white; font-size: 1.55rem; }
    .participation-card h3 { margin: 0 0 .25rem; font-size: 1rem; }.participation-card p { margin: 0; color: #5d6972; font-size: .78rem; line-height: 1.35; }.participation-card b { color: #65727a; font-size: 1.5rem; }
    .site-footer { padding: clamp(2.5rem, 5vw, 3rem) 0 2rem; background: var(--blue); color: white; }
    .footer-main { display: grid; gap: clamp(1.25rem, 3vw, 1.75rem); }.footer-brand { display: inline-flex; align-items: center; gap: .65rem; color: white; font-size: 1.3rem; font-weight: 800; text-decoration: none; }.footer-brand span { display: grid; width: 2.6rem; height: 2.6rem; place-content: center; border: 2px solid white; border-radius: .6rem; font-size: .62rem; }.footer-main p { margin: .5rem 0 0; opacity: .83; }.social-links { display: flex; gap: .65rem; }.social-links a { display: grid; width: 2.3rem; height: 2.3rem; place-content: center; border: 1px solid rgba(255,255,255,.8); border-radius: 50%; color: white; font-weight: 850; text-decoration: none; }.footer-main nav { display: flex; flex-wrap: wrap; gap: .75rem 1rem; }.footer-main nav a { color: white; font-size: .8rem; text-decoration: none; opacity: .92; }
    @media (max-width: 620px) { .carousel-button { display: none; } }
    @media (min-width: 620px) { .day-grid { grid-auto-columns: calc((100% - 2rem) / 3); }.featured-grid { grid-auto-flow: initial; grid-template-columns: repeat(3, 1fr); }.events-grid { grid-template-columns: repeat(2, 1fr); }.map-layout { grid-template-columns: .82fr 1.18fr; }.about-layout { grid-template-columns: 1fr 1fr; }.participation-grid { grid-template-columns: repeat(3, 1fr); }.participation-card { grid-template-columns: 1fr; align-items: start; }.participation-card b { position: absolute; align-self: end; justify-self: end; }.participation-card { position: relative; min-height: 210px; }.footer-main { grid-template-columns: 1fr auto 1fr; align-items: center; }.footer-main nav { justify-content: end; } }
    @media (min-width: 940px) { .hero { min-height: 810px; }.hero-content { padding-top: 6.5rem; }.hero h1 { max-width: 8.5ch; }.featured-grid { grid-template-columns: repeat(5, 1fr); }.events-grid { grid-template-columns: repeat(3, 1fr); }.event-card { grid-template-columns: 63px 1fr; }.event-card-date strong { font-size: 2.4rem; }.section-topline { margin-bottom: 2.6rem; } }
  </style>

  <script>
    const countdown = document.querySelector<HTMLElement>('[data-countdown]');
    const countdownValue = document.querySelector<HTMLElement>('[data-countdown-value]');
    const countdownLabel = document.querySelector<HTMLElement>('[data-countdown-label]');

    function updateCountdown() {
      if (!countdown || !countdownValue || !countdownLabel) return;
      const target = new Date(countdown.dataset.date ?? '').getTime();
      const difference = target - Date.now();
      if (difference <= 0) {
        countdownValue.textContent = '¡Ya!';
        countdownLabel.textContent = 'estamos de fiesta';
        return;
      }
      const days = Math.floor(difference / 86_400_000);
      countdownValue.textContent = String(days);
      countdownLabel.textContent = days === 1 ? 'día' : 'días';
    }
    updateCountdown();
    window.setInterval(updateCountdown, 60_000);

    const programmeTrack = document.querySelector<HTMLElement>('[data-programme-track]');
    const previousProgrammeDay = document.querySelector<HTMLButtonElement>('[data-programme-previous]');
    const nextProgrammeDay = document.querySelector<HTMLButtonElement>('[data-programme-next]');
    let programmeAutoplay: number | undefined;
    let programmeResume: number | undefined;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function getProgrammeStep() {
      if (!programmeTrack) return 0;
      const card = programmeTrack.querySelector<HTMLElement>('.day-card');
      const gap = Number.parseFloat(window.getComputedStyle(programmeTrack).columnGap) || 16;
      return (card?.getBoundingClientRect().width ?? programmeTrack.clientWidth) + gap;
    }

    const moveProgramme = (direction: number) => {
      if (!programmeTrack) return;
      const atStart = programmeTrack.scrollLeft <= 4;
      const atEnd = programmeTrack.scrollLeft + programmeTrack.clientWidth >= programmeTrack.scrollWidth - 4;

      if (direction < 0 && atStart) {
        programmeTrack.scrollTo({ left: programmeTrack.scrollWidth, behavior: 'smooth' });
        return;
      }

      if (direction > 0 && atEnd) {
        programmeTrack.scrollTo({ left: 0, behavior: 'smooth' });
        return;
      }

      programmeTrack.scrollBy({ left: direction * getProgrammeStep(), behavior: 'smooth' });
    };

    function pauseProgrammeAutoplay() {
      if (programmeAutoplay !== undefined) {
        window.clearInterval(programmeAutoplay);
        programmeAutoplay = undefined;
      }
    }

    function startProgrammeAutoplay() {
      if (!programmeTrack || reducedMotion || programmeAutoplay !== undefined || document.hidden) return;
      programmeAutoplay = window.setInterval(() => moveProgramme(1), 6000);
    }

    function resumeProgrammeAutoplayAfterInteraction() {
      if (programmeResume !== undefined) window.clearTimeout(programmeResume);
      programmeResume = window.setTimeout(startProgrammeAutoplay, 9000);
    }

    function moveProgrammeManually(direction: number) {
      pauseProgrammeAutoplay();
      moveProgramme(direction);
      resumeProgrammeAutoplayAfterInteraction();
    }

    previousProgrammeDay?.addEventListener('click', () => moveProgrammeManually(-1));
    nextProgrammeDay?.addEventListener('click', () => moveProgrammeManually(1));
    programmeTrack?.addEventListener('focusin', pauseProgrammeAutoplay);
    programmeTrack?.addEventListener('focusout', startProgrammeAutoplay);
    programmeTrack?.addEventListener('touchstart', pauseProgrammeAutoplay, { passive: true });
    programmeTrack?.addEventListener('touchend', resumeProgrammeAutoplayAfterInteraction, { passive: true });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) pauseProgrammeAutoplay();
      else startProgrammeAutoplay();
    });
    startProgrammeAutoplay();

    const search = document.querySelector<HTMLInputElement>('[data-search-events]');
    const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const eventCards = Array.from(document.querySelectorAll<HTMLElement>('[data-event]'));
    const eventCount = document.querySelector<HTMLElement>('[data-event-count]');
    const noEvents = document.querySelector<HTMLElement>('[data-no-events]');
    let selectedCategory = 'Todos';

    function applyFilters() {
      const term = search?.value.trim().toLowerCase() ?? '';
      let visible = 0;
      eventCards.forEach((card) => {
        const matchesCategory = selectedCategory === 'Todos' || card.dataset.category === selectedCategory;
        const matchesSearch = !term || card.dataset.search?.includes(term);
        const shouldShow = matchesCategory && matchesSearch;
        card.hidden = !shouldShow;
        if (shouldShow) visible += 1;
      });
      if (eventCount) eventCount.textContent = `${visible} ${visible === 1 ? 'actividad' : 'actividades'}`;
      if (noEvents) noEvents.hidden = visible !== 0;
    }

    search?.addEventListener('input', applyFilters);
    filters.forEach((filter) => filter.addEventListener('click', () => {
      selectedCategory = filter.dataset.filter ?? 'Todos';
      filters.forEach((button) => button.classList.toggle('active', button === filter));
      applyFilters();
    }));
  </script>
</BaseLayout>
