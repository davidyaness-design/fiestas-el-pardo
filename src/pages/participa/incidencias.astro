---
import ParticipationLayout from '../../components/ParticipationLayout.astro';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<ParticipationLayout
  eyebrow="Comunica una incidencia"
  title="Incidencias"
  description="Indica los problemas que encuentres en el barrio para que puedan revisarse. No uses este canal para urgencias: llama al 112."
>
  <p class="emergency-notice"><strong>Emergencias:</strong> si existe peligro inmediato para personas o bienes, llama al <a href="tel:112">112</a>.</p>
  <form class="participation-form" data-incident-form>
    <div class="form-grid">
      <label>Tipo de incidencia
        <select name="category" required>
          <option value="">Selecciona una categoría</option><option>Limpieza</option><option>Alumbrado</option><option>Vía pública</option><option>Mobiliario urbano</option><option>Zonas verdes</option><option>Ruido</option><option>Otro</option>
        </select>
      </label>
      <label>Ubicación <input name="location" required minlength="3" maxlength="180" placeholder="Calle, plaza o punto de referencia" /></label>
      <label class="full-field">Describe la incidencia <textarea name="description" required minlength="20" maxlength="2500" rows="7" placeholder="Explica qué ocurre y añade detalles que ayuden a localizarla."></textarea></label>
      <label class="full-field">Correo electrónico <span class="optional">(opcional, solo si necesitas respuesta)</span><input name="contactEmail" type="email" maxlength="254" placeholder="nombre@correo.es" /></label>
    </div>
    <label class="consent"><input type="checkbox" name="privacy" required /> He leído la información de privacidad y consiento el tratamiento de esta incidencia.</label>
    {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>}
    {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
    <p class="form-status" data-status role="status" aria-live="polite" hidden></p>
    <button class="submit-button" type="submit">Enviar incidencia <span aria-hidden="true">→</span></button>
  </form>
</ParticipationLayout>

<style>
  .emergency-notice { max-width: 800px; margin: 0 0 1.5rem; border-left: 4px solid var(--accent); padding: .9rem 1rem; background: #fff5eb; color: #6b3d20; line-height: 1.5; }.emergency-notice a { color: inherit; font-weight: 900; }.participation-form { max-width: 800px; }.form-grid { display: grid; gap: 1.15rem; }.participation-form label { display: grid; gap: .45rem; color: #263b4a; font-size: .9rem; font-weight: 800; }.participation-form input, .participation-form select, .participation-form textarea { width: 100%; border: 1px solid #b9c8d2; border-radius: .7rem; padding: .78rem .85rem; background: white; color: var(--ink); font: inherit; font-weight: 500; }.participation-form textarea { resize: vertical; }.optional { color: #687680; font-size: .75rem; font-weight: 600; }.consent { grid-template-columns: 1.1rem 1fr; align-items: start; margin: 1.4rem 0; line-height: 1.4; }.consent input { width: 1.1rem; height: 1.1rem; margin-top: .05rem; accent-color: var(--blue); }.form-status { border-radius: .7rem; padding: .8rem 1rem; font-size: .9rem; font-weight: 700; }.form-status[data-type="error"] { background: #fff0ed; color: #9b3223; }.form-status[data-type="success"] { background: #e8f8ea; color: #266536; }.submit-button { display: inline-flex; align-items: center; gap: .55rem; border: 0; border-radius: .75rem; padding: .85rem 1.15rem; background: var(--blue); color: white; font-weight: 850; cursor: pointer; }.submit-button:disabled { cursor: wait; opacity: .68; }
  @media (min-width: 640px) { .form-grid { grid-template-columns: 1fr 1fr; }.full-field { grid-column: 1 / -1; } }
</style>

<script>
  import { getTurnstileToken, participationRequest, setStatus } from '../../scripts/participation';

  const form = document.querySelector<HTMLFormElement>('[data-incident-form]');
  const status = form?.querySelector<HTMLElement>('[data-status]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    button?.setAttribute('disabled', 'true');
    const values = new FormData(form);
    try {
      await participationRequest('submit_incident', {
        category: values.get('category'), location: values.get('location'), description: values.get('description'), contactEmail: values.get('contactEmail'), turnstileToken: getTurnstileToken(),
      });
      form.reset();
      if (status) setStatus(status, 'Hemos recibido la incidencia. Gracias por avisarnos.', 'success');
    } catch (error) {
      if (status) setStatus(status, error instanceof Error ? error.message : 'No se ha podido enviar la incidencia.', 'error');
    } finally {
      button?.removeAttribute('disabled');
    }
  });
</script>
