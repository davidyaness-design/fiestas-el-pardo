---
import ParticipationLayout from '../../components/ParticipationLayout.astro';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<ParticipationLayout
  eyebrow="Tu propuesta"
  title="Propón tu idea"
  description="Comparte una propuesta concreta para mejorar Fuencarral–El Pardo. El equipo municipal la recibirá para su valoración."
  eyebrowKey="idea.eyebrow"
  titleKey="idea.title"
  descriptionKey="idea.description"
>
  <form class="participation-form" data-idea-form>
    <div class="form-grid">
      <label class="full-field"><span data-i18n="idea.fieldTitle">Título de la propuesta</span> <input name="title" required minlength="8" maxlength="120" placeholder="Ej.: Más sombra en la plaza" data-i18n-placeholder="idea.titlePlaceholder" /></label>
      <label><span data-i18n="idea.area">Área</span>
        <select name="category" required>
          <option value="" data-i18n="idea.selectArea">Selecciona un área</option><option data-i18n="idea.publicSpace">Espacio público</option><option data-i18n="idea.culture">Cultura y ocio</option><option data-i18n="idea.mobility">Movilidad</option><option data-i18n="idea.environment">Medio ambiente</option><option data-i18n="idea.youth">Infancia y juventud</option><option data-i18n="common.other">Otro</option>
        </select>
      </label>
      <label><span data-i18n="common.location">Barrio o zona</span> <input name="location" required minlength="3" maxlength="120" placeholder="Ej.: El Pardo" /></label>
      <label class="full-field"><span data-i18n="idea.tellUs">Cuéntanos tu idea</span> <textarea name="description" required minlength="30" maxlength="2500" rows="7" placeholder="Describe qué propones, dónde tendría impacto y por qué sería útil." data-i18n-placeholder="idea.descriptionPlaceholder"></textarea></label>
      <label class="full-field"><span data-i18n="common.email">Correo electrónico</span> <span class="optional" data-i18n="idea.emailOptional">(opcional, solo si quieres respuesta)</span><input name="contactEmail" type="email" maxlength="254" placeholder="nombre@correo.es" /></label>
    </div>
    <label class="consent"><input type="checkbox" name="privacy" required /><span><span data-i18n="idea.consentBefore">He leído la </span><a href="/privacidad" data-i18n="common.privacyInfo">información de privacidad</a><span data-i18n="idea.consentAfter"> y consiento el tratamiento de mi propuesta.</span></span></label>
    {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>}
    {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
    <p class="form-status" data-status role="status" aria-live="polite" hidden></p>
    <button class="submit-button" type="submit"><span data-i18n="idea.submit">Enviar propuesta</span> <span aria-hidden="true">→</span></button>
  </form>
</ParticipationLayout>

<style>
  .participation-form { max-width: 800px; }.form-grid { display: grid; gap: 1.15rem; }.participation-form label { display: grid; gap: .45rem; color: #263b4a; font-size: .9rem; font-weight: 800; }.participation-form input, .participation-form select, .participation-form textarea { width: 100%; border: 1px solid #b9c8d2; border-radius: .7rem; padding: .78rem .85rem; background: white; color: var(--ink); font: inherit; font-weight: 500; }.participation-form textarea { resize: vertical; }.optional { color: #687680; font-size: .75rem; font-weight: 600; }.participation-form label.consent { display: flex; align-items: flex-start; gap: .55rem; margin: 1.4rem 0; line-height: 1.45; }.consent input { width: 1.1rem; height: 1.1rem; flex: 0 0 1.1rem; margin-top: .05rem; padding: 0; accent-color: var(--blue); }.form-status { border-radius: .7rem; padding: .8rem 1rem; font-size: .9rem; font-weight: 700; }.form-status[data-type="error"] { background: #fff0ed; color: #9b3223; }.form-status[data-type="success"] { background: #e8f8ea; color: #266536; }.submit-button { display: inline-flex; align-items: center; gap: .55rem; border: 0; border-radius: .75rem; padding: .85rem 1.15rem; background: var(--blue); color: white; font-weight: 850; cursor: pointer; }.submit-button:disabled { cursor: wait; opacity: .68; }
  @media (min-width: 640px) { .form-grid { grid-template-columns: 1fr 1fr; }.full-field { grid-column: 1 / -1; } }
</style>

<script>
  import { getTurnstileToken, participationRequest, setStatus } from '../../scripts/participation';

  const form = document.querySelector<HTMLFormElement>('[data-idea-form]');
  const status = form?.querySelector<HTMLElement>('[data-status]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    button?.setAttribute('disabled', 'true');
    const values = new FormData(form);
    try {
      await participationRequest('submit_idea', {
        title: values.get('title'), category: values.get('category'), location: values.get('location'), description: values.get('description'), contactEmail: values.get('contactEmail'), turnstileToken: getTurnstileToken(),
      });
      form.reset();
      if (status) setStatus(status, 'Hemos recibido tu propuesta. Gracias por implicarte en el distrito.', 'success');
    } catch (error) {
      if (status) setStatus(status, error instanceof Error ? error.message : 'No se ha podido enviar la propuesta.', 'error');
    } finally {
      button?.removeAttribute('disabled');
    }
  });
</script>
