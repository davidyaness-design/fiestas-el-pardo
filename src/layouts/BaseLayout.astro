---
import '../styles/global.css';
import districtFavicon from '../../Fuencarral-Pardo-Distrito/Marca Fuencarral-Pardo-Distrito-azul.png';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Fiestas del Real Sitio de El Pardo 2026',
  description = 'Programa de las Fiestas del Real Sitio de El Pardo, del 29 de agosto al 6 de septiembre de 2026.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#075dbc" />
    <link rel="icon" type="image/png" href={districtFavicon.src} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
